# BuildEstate API settings. Copied to .env.local by "npm run setup".
# Never commit .env.local. Empty optional values simply turn that feature off.
# "npm run doctor" shows what is still missing.

# ---------- Required ----------

PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000

# The default is the local database started by "npm run dev" (no account needed).
# To use MongoDB Atlas instead, paste its connection string here:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/buildestate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27018/buildestate?replicaSet=buildestate-local

# "npm run setup" generates a value. To make your own: openssl rand -hex 32
JWT_SECRET=

# The admin account created by "npm run seed". "npm run setup" generates the password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Addresses of the two clients, used for CORS and for links inside emails.
WEBSITE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175
# Optional extra allowed origins, comma-separated.
EXTRA_ALLOWED_ORIGINS=

# ---------- Optional: photo uploads ----------
# Free account: https://imagekit.io. Without these, only new photo uploads fail.

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------- Optional: email ----------
# Free account: https://www.brevo.com. EMAIL_USER must be a sender verified in Brevo.
# Without these, verification and password reset links print in the API terminal.

BREVO_API_KEY=
EMAIL_USER=

# ---------- Optional: AI analysis ----------
# Key from https://build.nvidia.com. Needed for AI Hub, with a Firecrawl key
# that each user enters in the website. Firecrawl is not configured here.

NVIDIA_API_KEY=
