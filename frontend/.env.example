# BuildEstate website settings. Copied to .env.local by "npm run setup".
# VITE_ values are public and built into the browser code. Never put secrets here.

# API address, without a trailing /api.
VITE_API_BASE_URL=http://localhost:4000

# Shows the AI Hub search. Set to true locally. Leave unset on a public deployment to avoid using AI credits.
VITE_ENABLE_AI_HUB=true
